# ── Minecraft server ────────────────────────────────────────────────────────
MC_HOST=your.minecraft.server.com
MC_PORT=25565
# Dossier logs du serveur (monté en lecture seule) — PAS le fichier seul :
# monter le fichier gèle l'affichage à chaque rotation de latest.log
MC_LOG_DIR=/srv/minecraft/server/logs

# ── Fuseau horaire ──────────────────────────────────────────────────────────
# Doit correspondre au fuseau de la machine qui héberge le serveur Minecraft :
# l'heure des journaux en dépend (uptime faux si les fuseaux divergent).
TZ=Europe/Paris

# ── Métriques système ────────────────────────────────────────────────────────
# Dossier hôte à surveiller pour l'espace disque (monté en lecture seule)
# Exemples : /srv  /home  /opt  /data
SRV_PATH=/srv

# Cgroup de l'hôte monté en lecture seule (jauge RAM de la machine).
# En LXC Proxmox, lxcfs répond à /proc/meminfo selon le cgroup du processus qui
# lit : le conteneur y verrait sa propre mémoire (~50 Mio). La valeur est donc
# aussi lue dans /sys/fs/cgroup, monté par docker-compose.yml, et la plus grande
# des deux lectures est retenue. Sur serveur physique et en VM, ce fichier
# n'existe pas au niveau racine : seul psutil sert, ce qui y est exact.
# Ne pas changer, sauf montage différent.
#HOST_CGROUP=/host/cgroup

# Intervalle d'enregistrement des métriques en secondes (défaut : 60)
# 30 = haute fréquence | 60 = défaut | 300 = basse fréquence (moins de données)
#METRICS_INTERVAL=60

# ── Dashboard auth ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=changeme
SECRET_KEY=change-this-to-a-long-random-string

# ── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=localhost

# ── TLS / SSL ────────────────────────────────────────────────────────────────
# Mode 1 (défaut) — self-signed auto, parfait pour LAN/local
#   → Utilise Caddyfile (tls internal), aucune config supplémentaire

# Mode 2 — Let's Encrypt (domaine public, ports 80+443 ouverts)
#   CADDYFILE=Caddyfile.letsencrypt
#   TLS_EMAIL=admin@example.com

# Mode 3 — Certificat existant (wildcard, entreprise…)
#   → Déposer fullchain.pem + privkey.pem dans ./certs/
#   CADDYFILE=Caddyfile.custom
